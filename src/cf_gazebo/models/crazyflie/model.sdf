<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Kinematic 6-DOF model for controller integration testing. -->
  <model name="crazyflie">
    <static>false</static>

    <link name="body">
      <inertial>
        <mass>0.027</mass>
        <inertia>
          <ixx>2.3951e-5</ixx>
          <iyy>2.3951e-5</iyy>
          <izz>3.2347e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.075 0.055 0.012</size>
          </box>
        </geometry>
      </collision>

      <visual name="center_deck">
        <geometry>
          <box>
            <size>0.075 0.055 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="front_left_arm">
        <pose>0.046 0.046 0 0 0 0.785398</pose>
        <geometry><box><size>0.080 0.008 0.006</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="front_right_arm">
        <pose>0.046 -0.046 0 0 0 -0.785398</pose>
        <geometry><box><size>0.080 0.008 0.006</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="rear_left_arm">
        <pose>-0.046 0.046 0 0 0 -0.785398</pose>
        <geometry><box><size>0.080 0.008 0.006</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="rear_right_arm">
        <pose>-0.046 -0.046 0 0 0 0.785398</pose>
        <geometry><box><size>0.080 0.008 0.006</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>

      <visual name="front_left_motor">
        <pose>0.072 0.072 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="front_right_motor">
        <pose>0.072 -0.072 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="rear_left_motor">
        <pose>-0.072 0.072 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="rear_right_motor">
        <pose>-0.072 -0.072 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>

      <visual name="front_left_propeller">
        <pose>0.072 0.072 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.001</length></cylinder></geometry>
        <material><diffuse>1 0.45 0 0.75</diffuse></material>
      </visual>
      <visual name="front_right_propeller">
        <pose>0.072 -0.072 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.001</length></cylinder></geometry>
        <material><diffuse>1 0.45 0 0.75</diffuse></material>
      </visual>
      <visual name="rear_left_propeller">
        <pose>-0.072 0.072 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.001</length></cylinder></geometry>
        <material><diffuse>0.12 0.12 0.12 0.75</diffuse></material>
      </visual>
      <visual name="rear_right_propeller">
        <pose>-0.072 -0.072 0.015 0 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.001</length></cylinder></geometry>
        <material><diffuse>0.12 0.12 0.12 0.75</diffuse></material>
      </visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl"/>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
